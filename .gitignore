reports/

# Temporary / scratch
scratch/
tmp/
backend/tests/manual/_scratch/

# Windows installer build: downloaded/generated locally by packaging/fetch_ffmpeg.py and
# PyInstaller/Inno Setup — never committed (the ffmpeg binaries alone are ~200 MB).
packaging/vendor/
packaging/build/
packaging/dist/
*.spec.bak
Output/

# Build-time bundled credentials — generated by packaging/bundle_env.py.
# Contains client-safe Supabase URL + anon key baked into the frozen build.
# Never commit this file.
backend/_bundled_config.py
