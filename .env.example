# .env.example — copy to .env and fill in real values.
# .env is gitignored — never commit real credentials.
#
# ── Desktop installer build ────────────────────────────────────────────────────
#
# SUPABASE_URL and SUPABASE_ANON_KEY are used by the desktop installer build.
# These are client-safe credentials — designed to be embedded in desktop/mobile
# apps and protected by Row Level Security (RLS) policies on your Supabase project.
# They do NOT grant privileged database access.
#
# Get them from: Supabase Dashboard → Settings → API
#   • "Project URL"   → SUPABASE_URL
#   • "anon public"   → SUPABASE_ANON_KEY
#
# Run before building: python packaging/bundle_env.py
# This bakes SUPABASE_URL + SUPABASE_ANON_KEY into the frozen build.
# The Postgres connection password is NOT bundled.
#
SUPABASE_URL=https://<your-project-ref>.supabase.co
SUPABASE_ANON_KEY=eyJ...

# ── Developer / server use (optional) ─────────────────────────────────────────
#
# DATABASE_URL — Postgres connection string with full credentials.
# Used when running from source (dev environment) or on a server deployment.
# This is a privileged credential and must NEVER be bundled into the installer.
# Leave unset when building the desktop installer (bundle_env.py will warn you).
#
# From Supabase: Project Settings → Database → Connection string → URI.
# Use the "Session pooler" connection (not "Direct connection"): Supabase's
# direct-connection hostname is IPv6-only unless you're on the paid IPv4
# add-on, which fails to connect on most local networks/CI runners.
#
# If your database password contains special characters (@, :, /, etc.),
# percent-encode them in the URL (e.g. '@' -> '%40').
#
# DATABASE_URL=postgresql://postgres.your-project-ref:your-url-encoded-password@aws-0-your-region.pooler.supabase.com:5432/postgres

# ── Case data storage ──────────────────────────────────────────────────────────
#
# Where forensic case data (exported clips, PDF reports) is stored on the
# local machine. Evidence files NEVER leave this directory.
# Defaults to C:\sih_cases on Windows, ~/sih_cases on Linux/macOS.
#
# FORENSIC_CASE_DIR=C:/sih_cases
